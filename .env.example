# Shared pair identity
H2S_PAIR_ID=desk
H2S_HERMES_ID=hermes-desk
H2S_STACKCHAN_ID=stackchan-desk
H2S_CAPABILITIES_FILE=capabilities/bridge-capabilities-desk.md
H2S_PERSONALITY_FILE=personalities/hermes-desk.md
H2S_PAIR_MOOD=playful
H2S_PRIVACY_MODE=normal
H2S_PAIR_PROACTIVITY=playful
H2S_PAIR_WAKEWORD=Computer
H2S_PAIR_VOICE=de-DE-KatjaNeural

# Bridge MQTT connection
H2S_MQTT_HOST=localhost
H2S_MQTT_PORT=1883
H2S_MQTT_CLIENT_ID=hermes2stackchan-bridge
H2S_MQTT_USERNAME=
H2S_MQTT_PASSWORD=
H2S_MQTT_TLS=false

# Bridge HTTP audio endpoint and STT
H2S_BRIDGE_HTTP_HOST=0.0.0.0
H2S_BRIDGE_HTTP_PORT=8788
H2S_BRIDGE_PUBLIC_URL=
H2S_STT_PROVIDER=groq
H2S_GROQ_API_KEY=
H2S_STT_MODEL=whisper-large-v3-turbo
H2S_STT_LANGUAGE=de
H2S_STT_TIMEOUT_S=30
H2S_TRANSCRIPT_DISPLAY_MS=9000
H2S_WAV_ARCHIVE_DIR=
H2S_TTS_DIR=
H2S_IMAGE_DIR=
H2S_MAX_IMAGE_BYTES=8388608
H2S_TTS_ENGINE=edge
H2S_EDGE_TTS_PYTHON=
H2S_EDGE_TTS_VOICE=de-DE-KatjaNeural
H2S_EDGE_TTS_RATE=+8%

# Hermes HTTP adapter
H2S_HERMES_BASE_URL=http://127.0.0.1:8642
H2S_HERMES_MODEL=default
H2S_HERMES_API_KEY=
H2S_HERMES_TIMEOUT_S=30

# Persistent reminders, stored outside git on the bridge host
H2S_REMINDER_STORE=~/.hermes/hermes2stackchan/reminders.json
H2S_REMINDER_POLL_S=1
H2S_REMINDER_DISPLAY_MS=9000

# Companion V1.0 state, history, and telemetry live outside git
H2S_COMPANION_STATE_STORE=~/.hermes/hermes2stackchan/companion_state.json
H2S_INTERACTION_HISTORY_STORE=~/.hermes/hermes2stackchan/interaction_history.jsonl
H2S_TELEMETRY_STORE=~/.hermes/hermes2stackchan/telemetry.jsonl
H2S_REPLAY_DEBUG_STORE=~/.hermes/hermes2stackchan/replay_debug.jsonl
H2S_HISTORY_KEEP=200
H2S_TELEMETRY_ENABLED=true
H2S_WATCHDOG_STALE_TIMEOUT_S=15
H2S_WATCHDOG_REBOOT_ON_STALE=false
H2S_REPLAY_DEBUG_KEEP=10

# Firmware local build config
H2S_WIFI_SSID=
H2S_WIFI_PASSWORD=
H2S_MQTT_URI=mqtt://localhost:1883
H2S_BRIDGE_AUDIO_URL=http://localhost:8788/stackchan/audio
H2S_WAKEWORD_LABEL=Computer
H2S_WAKEWORD_MODEL_HINT=computer
H2S_DISPLAY_BRIGHTNESS=80
H2S_STATUS_INTERVAL_MS=5000
