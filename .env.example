# Shared pair identity
H2S_PAIR_ID=desk
H2S_HERMES_ID=hermes-desk
H2S_STACKCHAN_ID=stackchan-desk
H2S_CAPABILITIES_FILE=capabilities/bridge-capabilities-desk.md
H2S_PERSONALITY_FILE=personalities/hermes-desk.md

# Bridge MQTT connection
H2S_MQTT_HOST=localhost
H2S_MQTT_PORT=1883
H2S_MQTT_CLIENT_ID=hermes2stackchan-bridge
H2S_MQTT_USERNAME=
H2S_MQTT_PASSWORD=
H2S_MQTT_TLS=false

# Hermes HTTP adapter
H2S_HERMES_BASE_URL=http://127.0.0.1:8642
H2S_HERMES_MODEL=default
H2S_HERMES_API_KEY=
H2S_HERMES_TIMEOUT_S=30

# Firmware local build config
H2S_WIFI_SSID=
H2S_WIFI_PASSWORD=
H2S_MQTT_URI=mqtt://localhost:1883
H2S_DISPLAY_BRIGHTNESS=80
H2S_STATUS_INTERVAL_MS=5000
