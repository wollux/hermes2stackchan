[Unit]
Description=Hermes2StackChan unified bridge
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hermes2stackchan
EnvironmentFile=/opt/hermes2stackchan/.env
ExecStart=/opt/hermes2stackchan/.venv/bin/h2s-bridge --config /opt/hermes2stackchan/config/pairs.example.json --env /opt/hermes2stackchan/.env run --pair desk
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
